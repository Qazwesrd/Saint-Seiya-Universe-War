config_version=5
[application]
config/name="圣斗士：宇宙之战"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
[autoload]
EventBus="*res://scripts/event_bus.gd"
SystemHealthManager="*res://scripts/system_health_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
LocalizationManager="*res://scripts/localization_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
ResourcePackManager="*res://scripts/resource_pack_manager.gd"
DialogueManager="*res://scripts/dialogue_manager.gd"
SceneFlowManager="*res://scripts/scene_flow_manager.gd"
RPGState="*res://scripts/rpg_state.gd"
QuestManager="*res://scripts/quest_manager.gd"
SkillSystem="*res://scripts/skill_system.gd"
GMManager="*res://scripts/gm_manager.gd"
ArmorSystem="*res://scripts/armor_system.gd"
CollectionSystem="*res://scripts/collection_system.gd"
SanctuarySystem="*res://scripts/sanctuary_system.gd"
EquipmentDatabase="*res://scripts/equipment_database.gd"
EquipmentAffixManager="*res://scripts/equipment_affix_manager.gd"
EnemyDatabase="*res://scripts/enemy_database.gd"
CampaignManager="*res://scripts/campaign_manager.gd"
WorldExplorationManager="*res://scripts/world_exploration_manager.gd"
SideQuestManager="*res://scripts/side_quest_manager.gd"
DailyBossManager="*res://scripts/daily_boss_manager.gd"
EncounterDirector="*res://scripts/encounter_director.gd"
ComboPresetManager="*res://scripts/combo_preset_manager.gd"
CombatSessionManager="*res://scripts/combat_session_manager.gd"
LootManager="*res://scripts/loot_manager.gd"
ApplicationLifecycleManager="*res://scripts/application_lifecycle_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=1
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.055, 1)
