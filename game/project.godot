config_version=5
[application]
config/name="圣斗士：宇宙之战 - Android 战斗原型"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
[autoload]
RPGState="*res://scripts/rpg_state.gd"
QuestManager="*res://scripts/quest_manager.gd"
SkillSystem="*res://scripts/skill_system.gd"
GMManager="*res://scripts/gm_manager.gd"
ArmorSystem="*res://scripts/armor_system.gd"
CollectionSystem="*res://scripts/collection_system.gd"
SanctuarySystem="*res://scripts/sanctuary_system.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=1
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.055, 1)
